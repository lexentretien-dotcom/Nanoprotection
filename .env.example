# Public site configuration
NEXT_PUBLIC_SITE_URL=https://expertsnanoplus.com
# Keep false on staging. Set true only at production launch.
NEXT_PUBLIC_INDEXABLE=false

# Analytics (optional). Loaded only after visitor consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Google Preferred Sources button. Set true after checking eligibility at
# https://www.google.com/preferences/source
NEXT_PUBLIC_PREFERRED_SOURCES=false

# Address suggestions in the quote widget (optional). Canada Post AddressComplete key;
# without it the address field is a plain text field with browser autofill.
NEXT_PUBLIC_ADDRESSCOMPLETE_KEY=

# GoHighLevel (server only, never exposed to the browser)
GHL_API_KEY=
GHL_LOCATION_ID=
